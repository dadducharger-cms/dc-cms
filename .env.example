# Copy to .env (ignored by Git). Never put these secrets into frontend files.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=
# Use a supported Graph API version shown in your Meta app, e.g. vXX.0.
META_GRAPH_VERSION=
# Public HTTPS origin without a trailing path; needed for Meta callbacks.
PUBLIC_BASE_URL=
# Set true when serving the app over HTTPS.
COOKIE_SECURE=false

# Facebook Messenger: Page ID and Page access token.
FACEBOOK_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=

# Instagram Login API: professional account ID and Instagram user access token.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=

# Render production: persistent disk mounted at /var/data.
# NODE_ENV=production
# HOST=0.0.0.0
# DATABASE_PATH=/var/data/uocms.sqlite
# ADMIN_EMAIL=your-admin@example.com
# INITIAL_PASSWORD= (choose a unique password of at least 16 characters)
# COOKIE_SECURE=true
# PUBLIC_BASE_URL is optional on Render: defaults to RENDER_EXTERNAL_URL.
# On a custom domain, set PUBLIC_BASE_URL to that HTTPS origin.
